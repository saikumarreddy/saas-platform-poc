# API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# AWS Configuration (for local with LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_OVERRIDE=http://localstack:4566

# Application
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# DynamoDB
DYNAMODB_ENDPOINT=http://localstack:4566

# S3
S3_ENDPOINT=http://localstack:4566
S3_INGESTION_BUCKET=saas-poc-ingestion
S3_REPORTS_BUCKET=saas-poc-reports

# EventBridge
EVENTBRIDGE_BUS_NAME=default

# JWT
JWT_SECRET=test-secret-key-that-is-long-enough-for-testing-purposes

# LocalStack
LOCALSTACK_HOSTNAME=localstack
SERVICES=s3,dynamodb,eventbridge,sqs,sns
